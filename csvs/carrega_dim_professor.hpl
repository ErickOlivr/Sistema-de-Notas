    </GUI>
  </transform>

  <transform>
    <type>InsertUpdate</type>
    <name>Gravar dim_semestre</name>
    <lookup>
      <key>
        <name>ano</name>
        <field>ano</field>
        <condition>=</condition>
      </key>
      <key>
        <name>periodo</name>
        <field>semestre</field>
        <condition>=</condition>
      </key>
      <value>
        <name>ano</name>
        <rename>ano</rename>
        <update>Y</update>
      </value>
      <value>
        <name>semestre</name>
        <rename>periodo</rename>
        <update>Y</update>
      </value>
      <schema>public</schema>
      <table>dim_semestre</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>Y</update_bypassed>
    <connection>dw_aws</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>768</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>

  <order>
    <hop><from>Ler Turmas 2024</from><to>Selecionar Ano e Periodo</to><enabled>Y</enabled></hop>
    <hop><from>Selecionar Ano e Periodo</from><to>Ordenar</to><enabled>Y</enabled></hop>
    <hop><from>Ordenar</to><to>Remover Duplicados</to><enabled>Y</enabled></hop>
    <hop><from>Remover Duplicados</to><to>Gravar dim_semestre</to><enabled>Y</enabled></hop>
  </order>
</pipeline>