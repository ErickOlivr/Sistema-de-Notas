  </info>

  <transform>
    <type>CSVInput</type>
    <name>Ler Turmas 2024</name>
    <filename>C:\Users\omeca\Downloads\csvs\tur-csv-turmas-de-2024.csv</filename>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
