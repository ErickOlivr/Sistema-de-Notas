    <GUI>
      <xloc>112</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>

  <transform>
    <type>SelectValues</type>
    <name>Selecionar Ano e Periodo</name>
    <fields>
      <field><name>ano</name><rename/></field>
      <field><name>periodo</name><rename/></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>

  <transform>
    <type>SortRows</type>
    <name>Ordenar</name>
    <fields>
      <field>
        <name>ano</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <presorted>N</presorted>
      </field>
      <field>
        <name>periodo</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <presorted>N</presorted>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>448</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>

  <transform>
    <type>Unique</type>
    <name>Remover Duplicados</name>
    <count_rows>N</count_rows>
    <fields>
      <field>
        <name>ano</name>
        <case_insensitive>N</case_insensitive>
      </field>
      <field>
        <name>periodo</name>
        <case_insensitive>N</case_insensitive>
