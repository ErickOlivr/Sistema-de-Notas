  <transform>
    <type>TableInput</type>
    <name>Calcular Metricas SQL</name>
    <sql>SELECT 
    d.cod_disc AS codigo_componente,                     -- Nome real do dump: cod_disc
    ('TURMA ' || LPAD(t.numero::text, 2, '0')) AS codigo_turma, -- Formata "TURMA 01" completando com zero à esquerda
    COUNT(c.mat_estudante) as total_matriculados,
    ROUND(AVG(c.nota)::numeric, 2) as media_notas,
    SUM(CASE WHEN c.nota >= 5.0 THEN 1 ELSE 0 END) as numero_aprovados,
    SUM(CASE WHEN c.nota &lt; 5.0 THEN 1 ELSE 0 END) as numero_reprovados
FROM universidade.cursa c
JOIN universidade.turma t ON c.id_turma = t.id_turma
JOIN universidade.disciplina d ON t.cod_disc = d.cod_disc -- JOIN oficial usando cod_disc do dump
GROUP BY d.cod_disc, t.numero;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>relational_db</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>224</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
